# Maintainer: João Sá <joao.sa@familiasa.pt>
# Based on omarchy-fish by Ryan Hughes <ryan@omarchy.org>
# (https://github.com/omacom/omarchy-pkgs, pkgbuilds/omarchy-fish)

pkgname=omafish
_upstream=omarchy-fish
pkgver=1.5.0
pkgrel=1
pkgdesc="Omarchy shell configuration for Fish, with joaoptpsa's fixes"
arch=('any')
url="https://github.com/joaoptpsa/omafish"
license=('MIT')
depends=('fish' 'eza' 'mise' 'zoxide' 'starship' 'fzf' 'fd' 'bat')
makedepends=('git')
provides=("${_upstream}")
conflicts=("${_upstream}")
options=('!debug')
install=omafish.install
source=("${_upstream}::git+${url}.git"
        "fzf.fish-v10.3.tar.gz::https://github.com/PatrickF1/fzf.fish/archive/refs/tags/v10.3.tar.gz")
sha256sums=('SKIP'
            'a0d56e974b8d5144c3262dcf87630c8886407d28a2f9e626e46bc18199fe6f97')

pkgver() {
  cd "${srcdir}/${_upstream}"
  git describe --long --tags --abbrev=7 | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g'
}

package() {
  cd "${srcdir}/${_upstream}"

  # Install fzf.fish to vendor directories
  install -dm755 "${pkgdir}/usr/share/fish/vendor_conf.d"
  install -dm755 "${pkgdir}/usr/share/fish/vendor_functions.d"
  install -dm755 "${pkgdir}/usr/share/fish/vendor_completions.d"
  cp "${srcdir}/fzf.fish-10.3/conf.d/"*.fish "${pkgdir}/usr/share/fish/vendor_conf.d/"
  cp "${srcdir}/fzf.fish-10.3/functions/"*.fish "${pkgdir}/usr/share/fish/vendor_functions.d/"
  cp "${srcdir}/fzf.fish-10.3/completions/"*.fish "${pkgdir}/usr/share/fish/vendor_completions.d/"

  # Install omarchy-fish conf.d, functions, and completions.
  # dotglob so leading-dot function names like ....fish are not skipped.
  shopt -s dotglob
  cp conf.d/*.fish "${pkgdir}/usr/share/fish/vendor_conf.d/"
  cp functions/*.fish "${pkgdir}/usr/share/fish/vendor_functions.d/"
  cp completions/*.fish "${pkgdir}/usr/share/fish/vendor_completions.d/"
  shopt -u dotglob

  # Templates stay under the upstream name: omarchy-setup-fish reads
  # /usr/share/omarchy-fish/templates/bashrc.
  install -dm755 "${pkgdir}/usr/share/${_upstream}"
  cp -r templates LICENSE README.md "${pkgdir}/usr/share/${_upstream}/"
  cp "${srcdir}/fzf.fish-10.3/LICENSE.md" "${pkgdir}/usr/share/${_upstream}/LICENSE.fzf.fish"
  cp "${srcdir}/fzf.fish-10.3/README.md" "${pkgdir}/usr/share/${_upstream}/README.fzf.fish.md"

  install -Dm755 bin/omarchy-setup-fish "${pkgdir}/usr/bin/omarchy-setup-fish"
}
